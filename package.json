{
  "name": "birgus-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/http/main.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "typecheck": "tsc --noEmit",
    "test:smoke": "tsx scripts/smoke.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill:shipments": "tsx scripts/backfill-project-version-shipments.ts",
    "db:sync:module-agent-prompts": "tsx scripts/sync-module-agent-prompts.ts",
    "build:frontend": "npm --prefix frontend run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/client": "^6.16.2",
    "docx": "^9.6.1",
    "fastify": "^5.6.1",
    "nodemailer": "^8.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/nodemailer": "^8.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
