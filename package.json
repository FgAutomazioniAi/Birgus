{
  "name": "birgus-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/nest/main.ts",
    "dev:nest": "tsx src/nest/main.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "tsc",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev",
    "ai:smoke": "tsx scripts/smoke-ai-provider.ts",
    "e2e:smoke": "tsx scripts/system-smoke-e2e.ts",
    "e2e:chatbot": "tsx scripts/test-chatbot-e2e.ts",
    "check:mvp": "npm run security:check && npm run typecheck && npm test && npm run build:frontend && npm run e2e:smoke",
    "security:check": "tsx scripts/security-check.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill:shipments": "tsx scripts/backfill-project-version-shipments.ts",
    "db:sync:module-agent-prompts": "tsx scripts/sync-module-agent-prompts.ts",
    "workspace:provision": "tsx scripts/provision-workspace.ts",
    "build:frontend": "npm --prefix frontend run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@lottiefiles/dotlottie-react": "^0.19.2",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/client": "^6.19.3",
    "docx": "^9.6.1",
    "fastify": "^5.6.1",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "@fastify/static": "^10.1.3",
    "deepmerge-ts": "8.0.2",
    "js-yaml": "^5.2.3"
  }
}
