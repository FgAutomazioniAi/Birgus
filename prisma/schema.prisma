  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt
  deleted_at        DateTime?

  session     AssistantSession    @relation(fields: [session_id], references: [id], onDelete: Cascade)
  workspace   Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  author_user User?               @relation("assistant_message_author", fields: [author_user_id], references: [id], onDelete: SetNull)
  tool_calls  AssistantToolCall[]

  @@unique([session_id, sequence_no])
  @@index([workspace_id])
  @@index([author_user_id])
  @@index([role])
  @@index([created_at])
  @@index([deleted_at])
  @@map("assistant_messages")
}

model AssistantToolCall {
  id                    String                  @id @default(uuid()) @db.Uuid
  session_id            String                  @db.Uuid
  message_id            String?                 @db.Uuid
  workspace_id          String                  @db.Uuid
  module_id             Int?
  tool_name             String
  status                AssistantToolCallStatus @default(REQUESTED)
  arguments_payload     Json?
  result_payload        Json?
  authorization_context Json?
  denied_reason         String?
  started_at            DateTime?
  completed_at          DateTime?
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt

  session   AssistantSession  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  message   AssistantMessage? @relation(fields: [message_id], references: [id], onDelete: SetNull)
  workspace Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  module    Module?           @relation(fields: [module_id], references: [id], onDelete: SetNull)

  @@index([session_id])
  @@index([message_id])
  @@index([workspace_id])
  @@index([module_id])
  @@index([status])
  @@index([created_at])
  @@map("assistant_tool_calls")
}

model AssistantMemorySnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  session_id      String   @db.Uuid
  workspace_id    String   @db.Uuid
  summary_text    String   @db.Text
  extracted_facts Json?
  message_count   Int      @default(0)
  token_estimate  Int?
  generated_at    DateTime @default(now())

  session   AssistantSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Restrict)

  @@index([session_id])
  @@index([workspace_id])
  @@index([generated_at])
  @@map("assistant_memory_snapshots")
}

model KnowledgeDocument {
  id                 String                  @id @default(uuid()) @db.Uuid
  workspace_id       String                  @db.Uuid
  module_id          Int?
  document_id        String?                 @db.Uuid
  source_entity_type String
  source_entity_id   String
  representation_key String                  @default("primary")
  title              String?
  source_label       String?
  content_text       String?                 @db.Text
  summary_text       String?                 @db.Text
  structured_payload Json?
  extraction_status  KnowledgeDocumentStatus @default(PENDING)
  extraction_kind    String?
  content_hash       String?
  last_error         String?
  extracted_at       DateTime?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt
  deleted_at         DateTime?

  workspace Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  module    Module?          @relation(fields: [module_id], references: [id], onDelete: SetNull)
  document  Document?        @relation(fields: [document_id], references: [id], onDelete: SetNull)
  chunks    KnowledgeChunk[]

  @@unique([workspace_id, source_entity_type, source_entity_id, representation_key])
  @@index([workspace_id])
  @@index([module_id])
  @@index([document_id])
  @@index([extraction_status])
  @@index([deleted_at])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id                    String                        @id @default(uuid()) @db.Uuid
  workspace_id          String                        @db.Uuid
  knowledge_document_id String                        @db.Uuid
  chunk_index           Int
  content_text          String                        @db.Text
  token_estimate        Int?
  embedding_status      KnowledgeChunkEmbeddingStatus @default(PENDING)
  embedding_provider    String?
  embedding_model       String?
  embedding_dimensions  Int?
  embedding_vector      Unsupported("vector")?
  embedding_payload     Json?
  metadata              Json?
  embedded_at           DateTime?
  created_at            DateTime                      @default(now())
  updated_at            DateTime                      @updatedAt

  workspace          Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  knowledge_document KnowledgeDocument @relation(fields: [knowledge_document_id], references: [id], onDelete: Cascade)

  @@unique([knowledge_document_id, chunk_index])
  @@index([workspace_id])
  @@index([knowledge_document_id])
  @@index([embedding_status])
  @@map("knowledge_chunks")
}

model Notification {
  id           Int       @id @default(autoincrement())
  workspace_id String    @db.Uuid
  user_id      String?   @db.Uuid
  module_id    Int?
  type         String    @default("info")
  title        String
  message      String
  reference    String?
  read_at      DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  module    Module?   @relation(fields: [module_id], references: [id], onDelete: SetNull)

  @@index([workspace_id])
  @@index([user_id])
  @@index([module_id])
  @@index([read_at])
  @@index([deleted_at])
  @@map("notifications")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  workspace_id String   @db.Uuid
  user_id      String?  @db.Uuid
  module_id    Int?
  action       String
  entity_type  String
  entity_id    String?  @db.Uuid
  payload      Json?
  ip_address   String?
  user_agent   String?
  created_at   DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  module    Module?   @relation(fields: [module_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_at])
  @@index([entity_type, entity_id])
  @@index([user_id])
  @@index([module_id])
  @@map("audit_logs")
}
