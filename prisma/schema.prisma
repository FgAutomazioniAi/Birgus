generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ModuleOverrideMode {
  ALLOW
  DENY
}

enum DocumentScope {
  WORKSPACE
  PROJECT
  SHIPMENT
  DDT
  MEASURE_REPORT
  OTHER
}

enum DdtDocumentStatus {
  UPLOADED
  QUEUED
  OCR_PROCESSING
  AI_PROCESSING
  READY
  ERROR
}

enum DdtJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum MeasureReportDocumentStatus {
  UPLOADED
  QUEUED
  AI_PROCESSING
  READY
  ERROR
}

enum QuotationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum MailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AssistantSessionStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum AssistantMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum AssistantToolCallStatus {
  REQUESTED
  RUNNING
  SUCCEEDED
  FAILED
  DENIED
  CANCELED
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  ERROR
  STALE
}

enum KnowledgeChunkEmbeddingStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum WorkflowNodeKind {
  INPUT
  AGENT
  TOOL
  OUTPUT
}

enum WorkflowToolRuntimeKind {
  BACKEND
  PYTHON_MODULE
  NEXT_ORCHESTRATOR
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELED
}

enum BackendJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Organization {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique
  legal_name String
  vat_number String?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  deleted_at DateTime?
  workspaces Workspace[]

  @@map("organizations")
}

model Workspace {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  code            String
  name            String
  timezone        String    @default("Europe/Rome")
  locale          String    @default("it-IT")
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  organization               Organization              @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  memberships                WorkspaceMembership[]
  user_workspace_roles       UserWorkspaceRole[]
  workspace_modules          WorkspaceModule[]
  user_module_overrides      UserModuleOverride[]
  user_preferences           UserPreference[]
  nodes                      Node[]
  documents                  Document[]
  companies                  Company[]
  clients                    Client[]
  project_statuses           ProjectStatus[]
  project_revisions          ProjectRevision[]
  project_authors            ProjectAuthor[]
  projects                   Project[]
  module_agents              ModuleAgent[]
  project_clients            ProjectClient[]
  project_versions           ProjectVersion[]
  shipment_statuses          ShipmentStatus[]
  shipments                  Shipment[]
  shipment_specifications    ShipmentSpecification[]
  ddt_documents              DdtDocument[]
  measure_report_documents   MeasureReportDocument[]
  ddt_processing_jobs        DdtProcessingJob[]
  quotation_orchestrator_jobs QuotationOrchestratorJob[]
  notifications              Notification[]
  audit_logs                 AuditLog[]
  assistant_sessions         AssistantSession[]
  assistant_messages         AssistantMessage[]
  assistant_tool_calls       AssistantToolCall[]
  assistant_memory_snapshots AssistantMemorySnapshot[]
  knowledge_documents        KnowledgeDocument[]
  knowledge_chunks           KnowledgeChunk[]
  module_tools               ModuleTool[]
  module_workflows           ModuleWorkflow[]
  module_workflow_nodes      ModuleWorkflowNode[]
  module_workflow_edges      ModuleWorkflowEdge[]
  module_workflow_runs       ModuleWorkflowRun[]
  module_workflow_run_steps  ModuleWorkflowRunStep[]

  @@unique([organization_id, code])
  @@index([organization_id])
  @@index([deleted_at])
  @@map("workspaces")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  first_name          String
  last_name           String?
  email               String    @unique
  password_hash       String?
  password_updated_at DateTime  @default(now())
  two_factor_enabled  Boolean   @default(false)
  two_factor_secret_ciphertext String?
  two_factor_enabled_at DateTime?
  two_factor_last_verified_at DateTime?
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  memberships                      WorkspaceMembership[]
  user_workspace_roles             UserWorkspaceRole[]
  auth_sessions                    AuthSession[]
  auth_login_challenges            AuthLoginChallenge[]
  password_reset_codes             PasswordResetCode[]
  user_preferences                 UserPreference[]
  workspace_modules_configured     WorkspaceModule[]     @relation("workspace_module_configured_by")
  user_module_overrides            UserModuleOverride[]  @relation("user_module_override_target")
  user_module_overrides_configured UserModuleOverride[]  @relation("user_module_override_configured_by")
  documents_uploaded               Document[]            @relation("document_uploaded_by")
  projects_owned                   Project[]             @relation("project_owner")
  module_agents_created            ModuleAgent[]         @relation("module_agent_created_by")
  module_agents_updated            ModuleAgent[]         @relation("module_agent_updated_by")
  module_tools_created             ModuleTool[]          @relation("module_tool_created_by")
  module_tools_updated             ModuleTool[]          @relation("module_tool_updated_by")
  module_workflows_created         ModuleWorkflow[]      @relation("module_workflow_created_by")
  module_workflows_updated         ModuleWorkflow[]      @relation("module_workflow_updated_by")
  shipments_created                Shipment[]            @relation("shipment_created_by")
  shipment_events                  ShipmentEvent[]       @relation("shipment_event_actor")
  ddt_documents_requested          DdtDocument[]         @relation("ddt_document_requested_by")
  measure_report_documents_requested MeasureReportDocument[] @relation("measure_report_document_requested_by")
  notifications                    Notification[]
  audit_logs                       AuditLog[]
  assistant_sessions_opened        AssistantSession[]    @relation("assistant_session_opened_by")
  assistant_messages_authored      AssistantMessage[]    @relation("assistant_message_author")
  quotation_jobs_requested         QuotationOrchestratorJob[] @relation("quotation_job_requested_by")
  workflow_runs_requested          ModuleWorkflowRun[]   @relation("module_workflow_run_requested_by")

  @@index([deleted_at])
  @@map("users")
}

model WorkspaceMembership {
  id           Int              @id @default(autoincrement())
  workspace_id String           @db.Uuid
  user_id      String           @db.Uuid
  status       MembershipStatus @default(ACTIVE)
  joined_at    DateTime         @default(now())
  left_at      DateTime?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([workspace_id, user_id])
  @@index([workspace_id])
  @@index([user_id])
  @@map("workspace_memberships")
}

model Role {
  id                   Int                 @id @default(autoincrement())
  key                  String              @unique
  label                String
  is_system            Boolean             @default(false)
  role_permissions     RolePermission[]
  user_workspace_roles UserWorkspaceRole[]

  @@map("roles")
}

model Permission {
  id               Int              @id @default(autoincrement())
  key              String           @unique
  label            String
  description      String?
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            Int @id @default(autoincrement())
  role_id       Int
  permission_id Int

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model UserWorkspaceRole {
  id           Int      @id @default(autoincrement())
  workspace_id String   @db.Uuid
  user_id      String   @db.Uuid
  role_id      Int
  assigned_at  DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  role      Role      @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([workspace_id, user_id, role_id])
  @@index([workspace_id])
  @@index([user_id])
  @@index([role_id])
  @@map("user_workspace_roles")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  user_agent String?
  ip_address String?
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([revoked_at])
  @@index([user_id, revoked_at, expires_at])
  @@map("auth_sessions")
}

model PasswordResetCode {
  id         Int       @id @default(autoincrement())
  user_id    String    @db.Uuid
  code_hash  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([used_at])
  @@index([user_id, code_hash, used_at, expires_at])
  @@map("password_reset_codes")
}

model AuthLoginChallenge {
  id                           String    @id @default(uuid()) @db.Uuid
  user_id                      String    @db.Uuid
  challenge_hash               String    @unique
  remember_me                  Boolean   @default(false)
  requires_totp_setup          Boolean   @default(false)
  setup_secret_ciphertext      String?
  ip_address                   String?
  user_agent                   String?
  expires_at                   DateTime
  consumed_at                  DateTime?
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([consumed_at])
  @@index([user_id, consumed_at, expires_at])
  @@map("auth_login_challenges")
}

model UserPreference {
  id                Int      @id @default(autoincrement())
  user_id           String   @db.Uuid
  workspace_id      String?  @db.Uuid
  palette_id        String   @default("predefinito")
  language_code     String   @default("it")
  rows_projects     Int      @default(10)
  rows_clients      Int      @default(10)
  rows_shipments    Int      @default(10)
  columns_projects  Json?
  columns_clients   Json?
  columns_shipments Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: SetNull)

  @@unique([user_id, workspace_id])
  @@index([workspace_id])
  @@map("user_preferences")
}

model Module {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  name        String
  description String?
  is_core     Boolean @default(false)
  is_active   Boolean @default(true)

  workspace_modules     WorkspaceModule[]
  user_module_overrides UserModuleOverride[]
  module_agents         ModuleAgent[]
  module_tools          ModuleTool[]
  module_workflows      ModuleWorkflow[]
  workflow_runs         ModuleWorkflowRun[]
  documents             Document[]
  notifications         Notification[]
  audit_logs            AuditLog[]
  assistant_sessions    AssistantSession[]
  assistant_tool_calls  AssistantToolCall[]
  knowledge_documents   KnowledgeDocument[]
  dependencies          ModuleDependency[]   @relation("module_dependencies_module")
  dependents            ModuleDependency[]   @relation("module_dependencies_depends_on_module")

  @@map("modules")
}

model ModuleDependency {
  id                   Int @id @default(autoincrement())
  module_id            Int
  depends_on_module_id Int

  module            Module @relation("module_dependencies_module", fields: [module_id], references: [id], onDelete: Restrict)
  depends_on_module Module @relation("module_dependencies_depends_on_module", fields: [depends_on_module_id], references: [id], onDelete: Restrict)

  @@unique([module_id, depends_on_module_id])
  @@index([module_id])
  @@index([depends_on_module_id])
  @@map("module_dependencies")
}

model WorkspaceModule {
  id                    Int      @id @default(autoincrement())
  workspace_id          String   @db.Uuid
  module_id             Int
  is_enabled            Boolean  @default(true)
  configured_by_user_id String?  @db.Uuid
  configured_at         DateTime @default(now())

  workspace          Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  module             Module    @relation(fields: [module_id], references: [id], onDelete: Restrict)
  configured_by_user User?     @relation("workspace_module_configured_by", fields: [configured_by_user_id], references: [id], onDelete: SetNull)

  @@unique([workspace_id, module_id])
  @@index([workspace_id])
  @@index([module_id])
  @@index([configured_by_user_id])
  @@map("workspace_modules")
}

model UserModuleOverride {
  id                    Int                @id @default(autoincrement())
  workspace_id          String             @db.Uuid
  user_id               String             @db.Uuid
  module_id             Int
  mode                  ModuleOverrideMode
  reason                String?
  configured_by_user_id String?            @db.Uuid
  configured_at         DateTime           @default(now())

  workspace          Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user               User      @relation("user_module_override_target", fields: [user_id], references: [id], onDelete: Restrict)
  module             Module    @relation(fields: [module_id], references: [id], onDelete: Restrict)
  configured_by_user User?     @relation("user_module_override_configured_by", fields: [configured_by_user_id], references: [id], onDelete: SetNull)

  @@unique([workspace_id, user_id, module_id])
  @@index([workspace_id])
  @@index([user_id])
  @@index([module_id])
  @@index([configured_by_user_id])
  @@map("user_module_overrides")
}

model FileType {
  id         Int        @id @default(autoincrement())
  key        String     @unique
  mime_type  String?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  documents  Document[]

  @@map("file_types")
}

model FileStatus {
  id         Int        @id @default(autoincrement())
  key        String     @unique
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  documents  Document[]

  @@map("file_statuses")
}

model Node {
  id           String    @id @default(uuid()) @db.Uuid
  workspace_id String    @db.Uuid
  parent_id    String?   @db.Uuid
  name         String
  path_cache   String
  depth        Int       @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  workspace Workspace  @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  parent    Node?      @relation("node_tree", fields: [parent_id], references: [id], onDelete: SetNull)
  children  Node[]     @relation("node_tree")
  documents Document[]

  @@unique([workspace_id, path_cache])
  @@index([workspace_id])
  @@index([parent_id])
  @@index([deleted_at])
  @@map("nodes")
}

model Document {
  id                  String        @id @default(uuid()) @db.Uuid
  workspace_id        String        @db.Uuid
  node_id             String        @db.Uuid
  file_type_id        Int
  file_status_id      Int
  module_id           Int?
  scope               DocumentScope @default(WORKSPACE)
  domain_entity_type  String?
  domain_entity_id    String?
  filename            String?
  size_bytes          BigInt?
  storage_path        String
  checksum_sha256     String?
  uploaded_by_user_id String?       @db.Uuid
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  deleted_at          DateTime?

  workspace           Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  node                Node                @relation(fields: [node_id], references: [id], onDelete: Restrict)
  file_type           FileType            @relation(fields: [file_type_id], references: [id], onDelete: Restrict)
  file_status         FileStatus          @relation(fields: [file_status_id], references: [id], onDelete: Restrict)
  module              Module?             @relation(fields: [module_id], references: [id], onDelete: SetNull)
  uploaded_by_user    User?               @relation("document_uploaded_by", fields: [uploaded_by_user_id], references: [id], onDelete: SetNull)
  ddt_document        DdtDocument?
  measure_report_document MeasureReportDocument?
  assistant_sessions  AssistantSession[]
  workflow_runs       ModuleWorkflowRun[]
  knowledge_documents KnowledgeDocument[]

  @@index([workspace_id])
  @@index([node_id])
  @@index([module_id])
  @@index([uploaded_by_user_id])
  @@index([workspace_id, domain_entity_type, domain_entity_id])
  @@index([workspace_id, deleted_at])
  @@map("documents")
}

model Company {
  id           Int       @id @default(autoincrement())
  workspace_id String    @db.Uuid
  name         String
  address      String?
  postal_code  String?
  city         String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  clients   Client[]

  @@index([workspace_id])
  @@index([deleted_at])
  @@map("companies")
}

model Client {
  id           String    @id @default(uuid()) @db.Uuid
  workspace_id String    @db.Uuid
  company_id   Int?
  first_name   String
  last_name    String?
  phone        String?
  email        String?
  notes        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  workspace          Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  company            Company?           @relation(fields: [company_id], references: [id], onDelete: SetNull)
  project_clients    ProjectClient[]
  project_versions   ProjectVersion[]
  shipments          Shipment[]
  assistant_sessions AssistantSession[]
  workflow_runs      ModuleWorkflowRun[]

  @@index([workspace_id])
  @@index([company_id])
  @@index([deleted_at])
  @@index([workspace_id, email])
  @@index([workspace_id, first_name, last_name])
  @@map("clients")
}

model ProjectStatus {
  id           Int      @id @default(autoincrement())
  workspace_id String   @db.Uuid
  key          String
  label        String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  projects         Project[]
  project_versions ProjectVersion[]

  @@unique([workspace_id, key])
  @@index([workspace_id])
  @@map("project_statuses")
}

model ProjectRevision {
  id           Int      @id @default(autoincrement())
  workspace_id String   @db.Uuid
  code         String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  projects  Project[]

  @@unique([workspace_id, code])
  @@index([workspace_id])
  @@map("project_revisions")
}

model ProjectAuthor {
  id           Int       @id @default(autoincrement())
  workspace_id String    @db.Uuid
  first_name   String
  last_name    String?
  display_name String?
  notes        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  projects  Project[]

  @@index([workspace_id])
  @@index([deleted_at])
  @@index([workspace_id, first_name, last_name])
  @@index([workspace_id, display_name])
  @@map("project_authors")
}

model Project {
  id               String    @id @default(uuid()) @db.Uuid
  workspace_id     String    @db.Uuid
  name             String
  publication_date DateTime?
  author_date      DateTime?
  publisher_name   String?
  owner_user_id    String?   @db.Uuid
  author_id        Int?
  status_id        Int
  revision_id      Int?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  workspace          Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  owner_user         User?              @relation("project_owner", fields: [owner_user_id], references: [id], onDelete: SetNull)
  author             ProjectAuthor?     @relation(fields: [author_id], references: [id], onDelete: SetNull)
  status             ProjectStatus      @relation(fields: [status_id], references: [id], onDelete: Restrict)
  revision           ProjectRevision?   @relation(fields: [revision_id], references: [id], onDelete: SetNull)
  project_clients    ProjectClient[]
  project_versions   ProjectVersion[]
  quotation_jobs     QuotationOrchestratorJob[]
  assistant_sessions AssistantSession[]
  workflow_runs      ModuleWorkflowRun[]

  @@index([workspace_id])
  @@index([status_id])
  @@index([author_id])
  @@index([owner_user_id])
  @@index([deleted_at])
  @@index([workspace_id, name])
  @@map("projects")
}

model ModuleAgent {
  id                 String    @id @default(uuid()) @db.Uuid
  workspace_id       String    @db.Uuid
  module_id          Int
  key                String
  name               String
  label              String
  original_prompt    String    @db.Text
  active_prompt      String    @db.Text
  is_enabled         Boolean   @default(true)
  created_by_user_id String?   @db.Uuid
  updated_by_user_id String?   @db.Uuid
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  workspace       Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  module          Module    @relation(fields: [module_id], references: [id], onDelete: Restrict)
  created_by_user User?     @relation("module_agent_created_by", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  updated_by_user User?     @relation("module_agent_updated_by", fields: [updated_by_user_id], references: [id], onDelete: SetNull)
  workflow_nodes  ModuleWorkflowNode[]

  @@unique([workspace_id, module_id, key])
  @@index([workspace_id])
  @@index([module_id])
  @@index([created_by_user_id])
  @@index([updated_by_user_id])
  @@index([is_enabled])
  @@index([deleted_at])
  @@map("module_agents")
}

model ModuleTool {
  id                 String                  @id @default(uuid()) @db.Uuid
  workspace_id       String                  @db.Uuid
  module_id          Int
  key                String
  name               String
  label              String
  description        String?
  runtime_kind       WorkflowToolRuntimeKind
  handler_key        String
  input_schema       Json?
  output_schema      Json?
  configuration      Json?
  is_enabled         Boolean                 @default(true)
  created_by_user_id String?                 @db.Uuid
  updated_by_user_id String?                 @db.Uuid
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt
  deleted_at         DateTime?

  workspace       Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  module          Module              @relation(fields: [module_id], references: [id], onDelete: Restrict)
  created_by_user User?               @relation("module_tool_created_by", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  updated_by_user User?               @relation("module_tool_updated_by", fields: [updated_by_user_id], references: [id], onDelete: SetNull)
  workflow_nodes  ModuleWorkflowNode[]

  @@unique([workspace_id, module_id, key])
  @@index([workspace_id])
