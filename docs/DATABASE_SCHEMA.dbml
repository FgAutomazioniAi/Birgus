Project birgus_database {
  database_type: 'PostgreSQL'
}

Enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

Enum ModuleOverrideMode {
  ALLOW
  DENY
}

Enum DocumentScope {
  WORKSPACE
  PROJECT
  SHIPMENT
  DDT
  MEASURE_REPORT
  OTHER
}

Enum DdtDocumentStatus {
  UPLOADED
  QUEUED
  OCR_PROCESSING
  AI_PROCESSING
  READY
  ERROR
}

Enum MeasureReportDocumentStatus {
  UPLOADED
  QUEUED
  AI_PROCESSING
  READY
  ERROR
}

Enum DdtJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

Enum QuotationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

Enum MailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

Enum BackendJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

Enum AssistantSessionStatus {
  OPEN
  CLOSED
  ARCHIVED
}

Enum AssistantMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

Enum AssistantToolCallStatus {
  REQUESTED
  RUNNING
  SUCCEEDED
  FAILED
  DENIED
  CANCELED
}

Enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  ERROR
  STALE
}

Enum KnowledgeChunkEmbeddingStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

Enum WorkflowNodeKind {
  INPUT
  AGENT
  TOOL
  OUTPUT
}

Enum WorkflowToolRuntimeKind {
  BACKEND
  PYTHON_MODULE
  NEXT_ORCHESTRATOR
}

Enum WorkflowRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

Enum WorkflowStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELED
}

Table organizations {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  code varchar [unique, not null]
  legal_name varchar [not null]
  vat_number varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table workspaces {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  organization_id varchar [not null]
  code varchar [not null]
  name varchar [not null]
  timezone varchar [not null, default: "Europe/Rome"]
  locale varchar [not null, default: "it-IT"]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (organization_id, code) [unique]
    (organization_id)
    (deleted_at)
  }
}

Table users {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  first_name varchar [not null]
  last_name varchar
  email varchar [unique, not null]
  password_hash varchar
  password_updated_at timestamp [not null, default: `now()`]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (deleted_at)
  }
}

Table workspace_memberships {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  user_id varchar [not null]
  status MembershipStatus [not null]
  joined_at timestamp [not null, default: `now()`]
  left_at timestamp

  Indexes {
    (workspace_id, user_id) [unique]
    (workspace_id)
    (user_id)
  }
}

Table roles {
  id int [pk, not null, increment]
  key varchar [unique, not null]
  label varchar [not null]
  is_system boolean [not null, default: false]
}

Table permissions {
  id int [pk, not null, increment]
  key varchar [unique, not null]
  label varchar [not null]
  description varchar
}

Table role_permissions {
  id int [pk, not null, increment]
  role_id int [not null]
  permission_id int [not null]

  Indexes {
    (role_id, permission_id) [unique]
    (role_id)
    (permission_id)
  }
}

Table user_workspace_roles {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  user_id varchar [not null]
  role_id int [not null]
  assigned_at timestamp [not null, default: `now()`]

  Indexes {
    (workspace_id, user_id, role_id) [unique]
    (workspace_id)
    (user_id)
    (role_id)
  }
}

Table auth_sessions {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  user_id varchar [not null]
  token_hash varchar [unique, not null]
  user_agent varchar
  ip_address varchar
  expires_at timestamp [not null]
  revoked_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (user_id)
    (expires_at)
    (revoked_at)
    (user_id, revoked_at, expires_at)
  }
}

Table password_reset_codes {
  id int [pk, not null, increment]
  user_id varchar [not null]
  code_hash varchar [not null]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (user_id)
    (expires_at)
    (used_at)
    (user_id, code_hash, used_at, expires_at)
  }
}

Table user_preferences {
  id int [pk, not null, increment]
  user_id varchar [not null]
  workspace_id varchar
  palette_id varchar [not null, default: "predefinito"]
  language_code varchar [not null, default: "it"]
  rows_projects int [not null, default: 10]
  rows_clients int [not null, default: 10]
  rows_shipments int [not null, default: 10]
  columns_projects json
  columns_clients json
  columns_shipments json
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (user_id, workspace_id) [unique]
    (workspace_id)
  }
}

Table modules {
  id int [pk, not null, increment]
  key varchar [unique, not null]
  name varchar [not null]
  description varchar
  is_core boolean [not null, default: false]
  is_active boolean [not null, default: true]
}

Table module_dependencies {
  id int [pk, not null, increment]
  module_id int [not null]
  depends_on_module_id int [not null]

  Indexes {
    (module_id, depends_on_module_id) [unique]
    (module_id)
    (depends_on_module_id)
  }
}

Table workspace_modules {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  module_id int [not null]
  is_enabled boolean [not null, default: true]
  configured_by_user_id varchar
  configured_at timestamp [not null, default: `now()`]

  Indexes {
    (workspace_id, module_id) [unique]
    (workspace_id)
    (module_id)
    (configured_by_user_id)
  }
}

Table user_module_overrides {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  user_id varchar [not null]
  module_id int [not null]
  mode ModuleOverrideMode [not null]
  reason varchar
  configured_by_user_id varchar
  configured_at timestamp [not null, default: `now()`]

  Indexes {
    (workspace_id, user_id, module_id) [unique]
    (workspace_id)
    (user_id)
    (module_id)
    (configured_by_user_id)
  }
}

Table file_types {
  id int [pk, not null, increment]
  key varchar [unique, not null]
  mime_type varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
}

Table file_statuses {
  id int [pk, not null, increment]
  key varchar [unique, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
}

Table nodes {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  parent_id varchar
  name varchar [not null]
  path_cache varchar [not null]
  depth int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id, path_cache) [unique]
    (workspace_id)
    (parent_id)
    (deleted_at)
  }
}

Table documents {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  node_id varchar [not null]
  file_type_id int [not null]
  file_status_id int [not null]
  module_id int
  scope DocumentScope [not null]
  domain_entity_type varchar
  domain_entity_id varchar
  filename varchar
  size_bytes bigint
  storage_path varchar [not null]
  checksum_sha256 varchar
  uploaded_by_user_id varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id)
    (node_id)
    (module_id)
    (uploaded_by_user_id)
    (workspace_id, domain_entity_type, domain_entity_id)
    (workspace_id, deleted_at)
  }
}

Table companies {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  name varchar [not null]
  address varchar
  postal_code varchar
  city varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id)
    (deleted_at)
  }
}

Table clients {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  company_id int
  first_name varchar [not null]
  last_name varchar
  phone varchar
  email varchar
  notes varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id)
    (company_id)
    (deleted_at)
    (workspace_id, email)
    (workspace_id, first_name, last_name)
  }
}

Table project_statuses {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  key varchar [not null]
  label varchar [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (workspace_id, key) [unique]
    (workspace_id)
  }
}

Table project_revisions {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  code varchar [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (workspace_id, code) [unique]
    (workspace_id)
  }
}

Table project_authors {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  first_name varchar [not null]
  last_name varchar
  display_name varchar
  notes varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id)
    (deleted_at)
    (workspace_id, first_name, last_name)
    (workspace_id, display_name)
  }
}

Table projects {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  name varchar [not null]
  publication_date timestamp
  author_date timestamp
  publisher_name varchar
  owner_user_id varchar
  author_id int
  status_id int [not null]
  revision_id int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id)
    (status_id)
    (author_id)
    (owner_user_id)
    (deleted_at)
    (workspace_id, name)
  }
}

Table module_agents {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  module_id int [not null]
  key varchar [not null]
  name varchar [not null]
  label varchar [not null]
  original_prompt text [not null]
  active_prompt text [not null]
  is_enabled boolean [not null, default: true]
  created_by_user_id varchar
  updated_by_user_id varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id, module_id, key) [unique]
    (workspace_id)
    (module_id)
    (created_by_user_id)
    (updated_by_user_id)
    (is_enabled)
    (deleted_at)
  }
}

Table module_tools {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  module_id int [not null]
  key varchar [not null]
  name varchar [not null]
  label varchar [not null]
  description text
  runtime_kind WorkflowToolRuntimeKind [not null]
  handler_key varchar [not null]
  input_schema json
  output_schema json
  configuration json
  is_enabled boolean [not null, default: true]
  created_by_user_id varchar
  updated_by_user_id varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id, module_id, key) [unique]
    (workspace_id)
    (module_id)
    (created_by_user_id)
    (updated_by_user_id)
    (is_enabled)
    (deleted_at)
  }
}

Table module_workflows {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  module_id int [not null]
  key varchar [not null]
  name varchar [not null]
  label varchar [not null]
  description text
  version_no int [not null, default: 1]
  is_enabled boolean [not null, default: true]
  is_default boolean [not null, default: false]
  created_by_user_id varchar
  updated_by_user_id varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id, module_id, key) [unique]
    (workspace_id)
    (module_id)
    (created_by_user_id)
    (updated_by_user_id)
    (is_enabled)
    (is_default)
    (deleted_at)
  }
}

Table module_workflow_nodes {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workflow_id varchar [not null]
  workspace_id varchar [not null]
  node_key varchar [not null]
  node_kind WorkflowNodeKind [not null]
  label varchar [not null]
  position_x float [not null, default: 0]
  position_y float [not null, default: 0]
  module_agent_id varchar
  module_tool_id varchar
  input_kind varchar
  output_kind varchar
  configuration json
  input_schema json
  output_schema json
  is_enabled boolean [not null, default: true]
  is_required boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (workflow_id, node_key) [unique]
    (workflow_id)
    (workspace_id)
    (module_agent_id)
    (module_tool_id)
    (node_kind)
    (is_enabled)
    (is_required)
  }
}

Table module_workflow_edges {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workflow_id varchar [not null]
  workspace_id varchar [not null]
  source_node_id varchar [not null]
  target_node_id varchar [not null]
  source_handle varchar
  target_handle varchar
  label varchar
  condition_payload json
  order_no int [not null, default: 0]
  is_enabled boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (workflow_id)
    (workspace_id)
    (source_node_id)
    (target_node_id)
    (order_no)
    (is_enabled)
  }
}

Table module_workflow_runs {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  workflow_id varchar [not null]
  module_id int
  requested_by_user_id varchar
  status WorkflowRunStatus [not null, default: 'QUEUED']
  trigger_source varchar
  context_entity_type varchar
  context_entity_id varchar
  project_id varchar
  project_version_id int
  client_id varchar
  shipment_id varchar
  document_id varchar
  ddt_document_id varchar
  measure_report_document_id varchar
  input_payload json
  result_payload json
  error_message text
  queued_at timestamp [not null, default: `now()`]
  started_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (workspace_id)
    (workflow_id)
    (module_id)
    (requested_by_user_id)
    (project_id)
    (project_version_id)
    (client_id)
    (shipment_id)
    (document_id)
    (ddt_document_id)
    (measure_report_document_id)
    (status)
    (queued_at)
  }
}

Table module_workflow_run_steps {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  workflow_run_id varchar [not null]
  workflow_node_id varchar
  sequence_no int [not null]
  step_key varchar [not null]
  status WorkflowStepStatus [not null, default: 'PENDING']
  started_at timestamp
  completed_at timestamp
  input_payload json
  output_payload json
  error_message text
  logs_text text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (workflow_run_id, sequence_no) [unique]
    (workspace_id)
    (workflow_run_id)
    (workflow_node_id)
    (status)
  }
}

Table project_clients {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  project_id varchar [not null]
  client_id varchar [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id, project_id, client_id) [unique]
    (workspace_id)
    (project_id)
    (client_id)
    (deleted_at)
  }
}

Table project_versions {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  project_id varchar [not null]
  version_label varchar [not null]
  description varchar [not null]
  client_id varchar
  status_id int
  is_default boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id, project_id, version_label) [unique]
    (workspace_id)
    (project_id)
    (client_id)
    (status_id)
    (deleted_at)
    (workspace_id, project_id, is_default, deleted_at)
  }
}

Table shipment_statuses {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  key varchar [not null]
  label varchar [not null]

  Indexes {
    (workspace_id, key) [unique]
    (workspace_id)
  }
}

Table shipments {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  project_version_id int [not null]
  code varchar [not null]
  client_id varchar
  status_id int [not null]
  scheduled_date timestamp
  shipped_at timestamp
  delivered_at timestamp
  notes varchar
  created_by_user_id varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id, code) [unique]
    (project_version_id) [unique]
    (workspace_id)
    (project_version_id)
    (client_id)
    (status_id)
    (created_by_user_id)
    (deleted_at)
  }
}

Table shipment_specifications {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  shipment_id varchar [not null]
  input_payload json [not null]
  calculation_payload json [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (shipment_id) [unique]
    (workspace_id)
  }
}

Table shipment_items {
  id int [pk, not null, increment]
  shipment_id varchar [not null]
  sku varchar
  description varchar [not null]
  quantity decimal(14,3) [not null, default: 1]
  unit varchar
  weight_kg decimal(12,3)

  Indexes {
    (shipment_id)
  }
}

Table shipment_events {
  id int [pk, not null, increment]
  shipment_id varchar [not null]
  status_id int
  event_type varchar [not null]
  payload json
  actor_user_id varchar
  occurred_at timestamp [not null, default: `now()`]

  Indexes {
    (shipment_id)
    (status_id)
    (actor_user_id)
  }
}

Table ddt_documents {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  document_id varchar [unique, not null]
  status DdtDocumentStatus [not null]
  original_filename varchar
  last_error varchar
  requested_by_user_id varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (workspace_id)
    (status)
    (requested_by_user_id)
  }
}

Table ddt_analysis_results {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  ddt_document_id varchar [unique, not null]
  movement_type varchar
  movement_scope varchar
  main_warehouse_action varchar
  bolla_number varchar
  commessa_reference varchar
  transfer_note varchar
  article_count int
  warehouse_delta int
  summary varchar
  raw_response json
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
}

Table ddt_article_items {
  id int [pk, not null, increment]
  analysis_result_id varchar [not null]
  article_type varchar [not null]
  quantity decimal(14,3) [not null]
  unit varchar [not null, default: "N/D"]

  Indexes {
    (analysis_result_id)
  }
}

Table ddt_processing_jobs {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  ddt_document_id varchar [not null]
  status DdtJobStatus [not null]
  queued_at timestamp [not null, default: `now()`]
  started_at timestamp
  completed_at timestamp
  retries int [not null, default: 0]
  runner varchar
  error_message varchar

  Indexes {
    (workspace_id)
    (ddt_document_id)
    (status)
  }
}

Table ddt_processing_events {
  id int [pk, not null, increment]
  job_id varchar [not null]
  ddt_document_id varchar [not null]
  event_type varchar [not null]
  payload json
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (job_id)
    (ddt_document_id)
  }
}

Table measure_report_documents {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  document_id varchar [unique, not null]
  status MeasureReportDocumentStatus [not null, default: 'UPLOADED']
  original_filename varchar
  document_type_requested varchar [not null, default: 'auto']
  document_type_effective varchar
  last_error varchar
  requested_by_user_id varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (workspace_id)
    (status)
    (requested_by_user_id)
    (document_type_requested)
    (document_type_effective)
  }
}

Table measure_report_analysis_results {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  measure_report_document_id varchar [unique, not null]
  document_type_used varchar [not null]
  prompt_agent_key varchar
  rows_count int [not null, default: 0]
  summary varchar
  raw_output text
  raw_response json
  execution_metadata json
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (document_type_used)
    (prompt_agent_key)
  }
}

Table measure_report_analysis_rows {
  id int [pk, not null, increment]
  analysis_result_id varchar [not null]
  row_index int [not null]
  row_text text [not null]
  note varchar
  page_hint varchar
  raw_payload json

  Indexes {
    (analysis_result_id)
    (row_index)
  }
}

Table quotation_orchestrator_jobs {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  project_id varchar [not null]
  version_label varchar [not null]
  requested_by_user_id varchar
  client_name varchar
  status QuotationJobStatus [not null]
  progress int [not null, default: 0]
  message varchar
  step varchar
  error varchar
  output_docx_path varchar
  output_docx_storage_path varchar
  output_docx_size_bytes bigint
  email_recipient varchar
  mail_delivery_status MailDeliveryStatus [not null]
  mail_sent_at timestamp
  mail_error varchar
  final_message varchar
  queued_at timestamp [not null, default: `now()`]
  started_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (workspace_id)
    (project_id)
    (requested_by_user_id)
    (status)
    (queued_at)
    (mail_delivery_status)
  }
}

Table backend_jobs {
  id varchar [pk, not null]
  name varchar [not null]
  payload json [not null]
  status BackendJobStatus [not null, default: 'QUEUED']
  available_at timestamp [not null, default: `now()`]
  claimed_at timestamp
  claimed_by varchar
  attempts int [not null, default: 0]
  last_error varchar
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (status, available_at)
    (claimed_by)
    (created_at)
  }
}

Table assistant_sessions {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  opened_by_user_id varchar
  module_id int
  title varchar
  status AssistantSessionStatus [not null]
  context_entity_type varchar
  context_entity_id varchar
  project_id varchar
  project_version_id int
  client_id varchar
  shipment_id varchar
  document_id varchar
  ddt_document_id varchar
  opened_at timestamp [not null, default: `now()`]
  last_activity_at timestamp [not null, default: `now()`]
  closed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id)
    (opened_by_user_id)
    (module_id)
    (project_id)
    (project_version_id)
    (client_id)
    (shipment_id)
    (document_id)
    (ddt_document_id)
    (status)
    (last_activity_at)
    (deleted_at)
  }
}

Table assistant_messages {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  session_id varchar [not null]
  workspace_id varchar [not null]
  author_user_id varchar
  role AssistantMessageRole [not null]
  sequence_no int [not null]
  content_text text
  content_payload json
  model_name varchar
  prompt_tokens int
  completion_tokens int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (session_id, sequence_no) [unique]
    (workspace_id)
    (author_user_id)
    (role)
    (created_at)
    (deleted_at)
  }
}

Table assistant_tool_calls {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  session_id varchar [not null]
  message_id varchar
  workspace_id varchar [not null]
  module_id int
  tool_name varchar [not null]
  status AssistantToolCallStatus [not null]
  arguments_payload json
  result_payload json
  authorization_context json
  denied_reason varchar
  started_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (session_id)
    (message_id)
    (workspace_id)
    (module_id)
    (status)
    (created_at)
  }
}

Table assistant_memory_snapshots {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  session_id varchar [not null]
  workspace_id varchar [not null]
  summary_text text [not null]
  extracted_facts json
  message_count int [not null, default: 0]
  token_estimate int
  generated_at timestamp [not null, default: `now()`]

  Indexes {
    (session_id)
    (workspace_id)
    (generated_at)
  }
}

Table knowledge_documents {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  module_id int
  document_id varchar
  source_entity_type varchar [not null]
  source_entity_id varchar [not null]
  representation_key varchar [not null, default: "primary"]
  title varchar
  source_label varchar
  content_text text
  summary_text text
  structured_payload json
  extraction_status KnowledgeDocumentStatus [not null]
  extraction_kind varchar
  content_hash varchar
  last_error varchar
  extracted_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id, source_entity_type, source_entity_id, representation_key) [unique]
    (workspace_id)
    (module_id)
    (document_id)
    (extraction_status)
    (deleted_at)
  }
}

Table knowledge_chunks {
  id varchar [pk, not null, default: `uuid_generate_v4()`]
  workspace_id varchar [not null]
  knowledge_document_id varchar [not null]
  chunk_index int [not null]
  content_text text [not null]
  token_estimate int
  embedding_status KnowledgeChunkEmbeddingStatus [not null]
  embedding_provider varchar
  embedding_model varchar
  embedding_dimensions int
  embedding_vector vector
  embedding_payload json
  metadata json
  embedded_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (knowledge_document_id, chunk_index) [unique]
    (workspace_id)
    (knowledge_document_id)
    (embedding_status)
  }
}

Table notifications {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  user_id varchar
  module_id int
  type varchar [not null, default: "info"]
  title varchar [not null]
  message varchar [not null]
  reference varchar
  read_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp

  Indexes {
    (workspace_id)
    (user_id)
    (module_id)
    (read_at)
    (deleted_at)
  }
}

Table audit_logs {
  id int [pk, not null, increment]
  workspace_id varchar [not null]
  user_id varchar
  module_id int
  action varchar [not null]
  entity_type varchar [not null]
  entity_id varchar
  payload json
  ip_address varchar
  user_agent varchar
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (workspace_id, created_at)
    (entity_type, entity_id)
    (user_id)
    (module_id)
  }
}

