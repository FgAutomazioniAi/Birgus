# Birgus environment template. Copy this file to .env and replace every CHANGE_ME value.
# .env is intentionally ignored by Git. Never commit real credentials.

# Used only by Prisma commands launched from the HOST, not by the app container.
DATABASE_URL=postgresql://postgres:postgres@localhost:15433/birgus?schema=public

# Authentication and HTTP deployment
AUTH_PEPPER=CHANGE_ME_64_HEX_CHARACTERS
AUTH_SESSION_HOURS=12
AUTH_SESSION_REMEMBER_DAYS=30
AUTH_PASSWORD_RESET_CODE_TTL_MINUTES=15
AUTH_COOKIE_NAME=vl_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
TRUST_PROXY=false
BIRGUS_HOST_HTTP_PORT=80

# Garage object storage. The three Garage service tokens must match garage.local.toml.
GARAGE_RPC_SECRET=CHANGE_ME_64_HEX_CHARACTERS
GARAGE_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
GARAGE_METRICS_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
GARAGE_S3_ENDPOINT=http://localhost:13900
GARAGE_S3_REGION=garage
GARAGE_S3_BUCKET=birgus
GARAGE_S3_ACCESS_KEY_ID=birgus-local
GARAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME_LONG_RANDOM_SECRET
GARAGE_S3_FORCE_PATH_STYLE=true
GARAGE_STORAGE_PREFIX=projects

# Primary OpenAI-compatible AI provider. Use a LAN IP or a resolvable DNS name.
AI_PROVIDER=vllm
AI_PROVIDER_BASE_URL=http://internal-ai-vllm:8000/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_CHAT_MODEL=birgus-vl
AI_PROVIDER_EMBEDDING_MODEL=
AI_PROVIDER_COMPLETIONS_PATH=/v1/chat/completions
AI_PROVIDER_MODELS_PATH=/v1/models
AI_PROVIDER_TIMEOUT_MS=600000
AI_PROVIDER_TEMPERATURE=0
AI_PROVIDER_MAX_OUTPUT_TOKENS=512

# Knowledge retrieval and embeddings
KNOWLEDGE_EMBEDDING_PROVIDER=local-hash
KNOWLEDGE_EMBEDDING_DIMENSIONS=256
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_LM_EMBEDDINGS_PATH=/v1/embeddings
KNOWLEDGE_SEARCH_TOP_K=5

# Mail delivery. Leave SMTP values empty until mail is configured.
MAIL_PROVIDER=smtp
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional messaging integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Python, OCR and workflow runtime endpoints. Docker defaults are normally correct.
PYTHON_MODULES_BASE_URL=http://python_modules:8200
PYTHON_MODULES_EXECUTE_PATH=/v1/modules/execute
PYTHON_MODULES_TIMEOUT_MS=180000
OCR_ENGINE_BASE_URL=http://ocr_engine:8201
OCR_ENGINE_EXECUTE_PATH=/v1/modules/execute
OCR_ENGINE_TIMEOUT_MS=180000
OCR_ENGINE_LANG=it
OCR_LIFECYCLE_BASE_URL=http://ocr_lifecycle:8202
OCR_LIFECYCLE_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
ORCH_DDT_LM_MAX_TOKENS=700
ORCH_DDT_USE_JSON_SCHEMA=true
MEASURE_REPORT_ANALYSIS_MODE=auto
MEASURE_REPORT_MAX_PAGES=
MEASURE_REPORT_RENDER_SCALE=2.0
MEASURE_REPORT_MAX_IMAGE_SIZE=1800

# Optional managed vLLM lifecycle service. Required only with the ai-runtime profile.
VLLM_API_KEY=
VLLM_MODEL=
VLLM_SERVED_MODEL_NAME=birgus-vl
VLLM_MAX_MODEL_LEN=
VLLM_GPU_MEMORY_UTILIZATION=
VLLM_LIFECYCLE_BASE_URL=http://vllm_lifecycle:8203
VLLM_LIFECYCLE_TOKEN=

# Bundled workflow tools. Empty means enable every currently bundled standard tool.
# Allowed values: langchain_compose_email,langchain_format_text,workflow_format_template,
# workflow_verify_and_route,workflow_request_decision
WORKFLOW_STANDARD_TOOL_KEYS=

# Obsolete: do not add BIRGUS_SEED_PASSWORD. New installations create the first
# workspace and superuser explicitly with `npm run instance:initialize`.
